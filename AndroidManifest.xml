<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.github.mbanucu.wirelessadbkeeper"
    android:versionCode="11"
    android:versionName="1.10">

    <!-- Android 10 is the real floor: the reconnect features are built on
         WifiNetworkSuggestion and WifiNetworkSpecifier, which arrived in API 29.
         Lowering this only produced UnsupportedOperation paths and lint errors. -->
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <!-- Granted by `pm grant` from adb, which is the whole setup story; lint
         only knows that it is not for ordinary apps. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Probing 127.0.0.1:5555 needs a socket; without INTERNET even loopback
         connects fail, which made the pin watchdog report the port as closed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 12+ wants both location permissions declared before an app may
         read or change Wi-Fi networks; FINE is the one actually requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a type for every foreground service; the monitor
         is a specialUse one, and specialUse needs no runtime permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app ask Termux (whose adb is the paired client) to run the
         script that sends `adb tcpip 5555`; granted once with pm grant. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Package visibility: Android 11+ hides installed apps unless they are
         named here, and PinnedPort.hasTermux() is the one lookup that has to
         work on a fresh install, before this app has interacted with Termux. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:label="Wireless ADB Keeper"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Receives the result of a RUN_COMMAND the app sent to Termux, via
             the PendingIntent in com.termux.RUN_COMMAND_PENDING_INTENT. The
             PendingIntent names this service and comes from this app, so it
             stays unexported; see TermuxResultService. Older Termux ignores
             the extra and the port probe remains the fallback. The pin path
             runs before the first unlock, so this only touches the bundle and
             device-protected diagnostics. -->
        <service
            android:name=".TermuxResultService"
            android:directBootAware="true"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LOCKED_BOOT_COMPLETED is the reboot that matters: it runs before
             the first unlock, so the key and the pin path are reachable there.
             DokeOS does not inherit directBootAware from <application>, so it
             has to be written on each component that runs before unlock. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exported for `am broadcast` from adb, but only to holders of
             WRITE_SECURE_SETTINGS (shell, root, system and the app itself), so
             reconnect.sh's hint still works from an adb shell while an
             ordinary app's ENSURE is refused. -->
        <receiver
            android:name=".EnsureReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="io.github.mbanucu.wirelessadbkeeper.ENSURE" />
            </intent-filter>
        </receiver>

        <!-- The adb command surface: "adb shell content call" against this
             authority. It is exported, but callers are checked inside
             ControlProvider (uid, or the control token), so only shell, root,
             system, the app itself or a token holder get through. A provider
             is used instead of a receiver because the platform starts it even
             when the app was force-stopped or only just installed. -->
        <provider
            android:name=".ControlProvider"
            android:authorities="io.github.mbanucu.wirelessadbkeeper.control"
            android:exported="true" />

        <!-- Termux cannot use `content call`: the `content` command needs the
             signature permission ACCESS_CONTENT_PROVIDERS_EXTERNALLY, which
             only shell and root hold. This exported ordered broadcast is the
             app-reachable twin, with the same dispatch and the token gate;
             keeperctl.sh uses it. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.mbanucu.wirelessadbkeeper.CONTROL" />
            </intent-filter>
        </receiver>

        <!-- Exported, but only to holders of WRITE_SECURE_SETTINGS (shell, root,
             system and the app itself): Android 12+ refuses to let a background
             app start its own foreground service, so `am start-foreground-service`
             from adb is the only way to bring the monitor back after a
             force-stop. Other apps do not hold that permission. -->
        <service
            android:name=".MonitorService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps wireless debugging reachable for the paired laptop" />
        </service>

        <!-- The DokeOS autostart list has no settings key and no provider: the
             only way to change a row is to press its switch. This service reads
             that one window and clicks, which is why the autostart control
             call costs milliseconds instead of the ~33s uiautomator walk
             in autostart-allow.sh. res/xml/autostart_service.xml scopes it with
             packageNames, so it never sees another app's screen. Enabled once
             by install.sh (or by the app itself, which holds
             WRITE_SECURE_SETTINGS); it cannot run before unlock. -->
        <service
            android:name=".AutostartAccess"
            android:exported="true"
            android:label="Wireless ADB Keeper autostart"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autostart_service" />
        </service>

        <!-- Persisted jobs can run before unlock too; Ensurer and PinnedPort
             read no credential-protected app storage, so this is safe there. -->
        <service
            android:name=".EnsureJobService"
            android:directBootAware="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
